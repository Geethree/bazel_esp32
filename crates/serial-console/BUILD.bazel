load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

_HIL_ALIASES = dict(aliases())
_HIL_ALIASES.update({"//crates/hil-testing:hil_testing_host": "hil_testing"})

rust_binary(
    name = "serial-console",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "serial_console",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True, cargo_only = True) + ["//crates/serial-transport"],
)

rust_binary(
    name = "serial_console_hil",
    srcs = ["src/main.rs"],
    aliases = _HIL_ALIASES,
    crate_features = ["hil"],
    crate_name = "serial_console",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True, cargo_only = True) + [
        "//crates/hil-testing:hil_testing_host",
        "//crates/serial-transport",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":serial-console",
)

rust_test(
    name = "hil_unit_tests",
    crate = ":serial_console_hil",
)

exports_files(["README.md"])
