load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

_SRCS = glob(["src/**/*.rs"])

rust_library(
    name = "wifi-provisioning",
    srcs = _SRCS,
    aliases = aliases(),
    crate_features = ["device"],
    crate_name = "wifi_provisioning",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [":portal_assets"],
)

rust_library(
    name = "wifi_provisioning_hil",
    srcs = _SRCS,
    aliases = aliases(),
    crate_features = [
        "device",
        "hil",
    ],
    crate_name = "wifi_provisioning",
    edition = "2024",
    deps = all_crate_deps(normal = True, cargo_only = True) + [
        ":portal_assets",
        "//crates/hil-testing",
    ],
)

rust_library(
    name = "portal_assets",
    srcs = ["//crates/wifi-provisioning/portal:embedded_asset"],
    crate_name = "portal_assets",
    edition = "2024",
)

rust_test(
    name = "unit_tests",
    crate = ":wifi_provisioning_hil",
)
