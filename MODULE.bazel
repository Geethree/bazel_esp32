bazel_dep(name = "aspect_rules_esbuild", version = "0.26.0")
bazel_dep(name = "aspect_rules_js", version = "3.2.3")
bazel_dep(name = "llvm", version = "0.8.16")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_esp32", version = "0.1.0")
bazel_dep(name = "rules_rs", version = "0.0.98")

local_path_override(
    module_name = "rules_esp32",
    path = "bazel/modules/esp32",
)

include("//bazel/modules/esp32:rules_rs_override.MODULE.bazel")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
use_repo(toolchains, "default_rust_toolchains")

# Preserve the conventional @rules_rust repository name for Rust rule loads.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "riscv32imac-unknown-none-elf",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

esp32 = use_extension("@rules_esp32//:extensions.bzl", "esp32")
use_repo(esp32, "espflash")

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
)

register_execution_platforms(
    "//bazel/platforms:linux_aarch64_gnu",
    "//bazel/platforms:linux_x86_64_gnu",
    "//bazel/platforms:macos_aarch64",
)

osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "CoreFoundation",
    "Foundation",
    "IOKit",
])
use_repo(osx, "macos_sdk")
