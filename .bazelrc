common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

common --extra_execution_platforms=@bazel_tools//tools:host_platform

build:xiao_esp32c6 --platforms=//bazel/platforms:xiao_esp32c6
build:xiao_esp32c6 --compilation_mode=opt
build:s31_function_coreboard_1 --platforms=//bazel/platforms:s31_function_coreboard_1
build:s31_function_coreboard_1 --compilation_mode=opt

build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks

build --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build --output_groups=+rustfmt_checks

test --test_output=errors

# Control the parallelism of "slots" that hil tests can do at once locally
test --local_resources=esp32_slots=1
test --test_tag_filters=-hil
test:hil --test_tag_filters=

try-import %workspace%/.bazelrc.user
