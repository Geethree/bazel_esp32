load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

_ALIASES = dict(aliases())

_ALIASES.update({
    "//firmware/hil/support:host": "hil_testing",
    "//firmware/services/provisioning:host_hil": "wifi_provisioning",
})

rust_binary(
    name = "host",
    srcs = ["src/main.rs"],
    aliases = _ALIASES,
    crate_name = "provisioning_hil_host",
    edition = "2024",
    visibility = ["//firmware/hil/provisioning:__pkg__"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//firmware/hil/support:host",
        "//firmware/services/provisioning:host_hil",
        "//tools/serial/transport",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":host",
)
