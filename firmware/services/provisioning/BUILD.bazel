load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//firmware/build:selection.bzl", "portable_crates")

package(default_visibility = ["//visibility:public"])

_SRCS = glob(["src/**/*.rs"])

rust_library(
    name = "provisioning",
    srcs = _SRCS,
    crate_name = "wifi_provisioning",
    edition = "2024",
    deps = portable_crates(
        "crc-3.4.0",
        "embedded-storage-0.3.2",
        "heapless-0.8.0",
    ) + [":portal_assets"],
)

rust_library(
    name = "hil",
    srcs = _SRCS,
    crate_features = ["hil"],
    crate_name = "wifi_provisioning",
    edition = "2024",
    deps = portable_crates(
        "crc-3.4.0",
        "embedded-storage-0.3.2",
        "heapless-0.8.0",
    ) + [
        ":portal_assets",
        "//firmware/hil/support",
    ],
)

rust_library(
    name = "host_hil",
    srcs = _SRCS,
    aliases = aliases(),
    crate_features = ["hil"],
    crate_name = "wifi_provisioning",
    edition = "2024",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        ":portal_assets",
        "//firmware/hil/support:host",
    ],
)

rust_library(
    name = "portal_assets",
    srcs = ["//firmware/services/provisioning/portal:embedded_asset"],
    crate_name = "portal_assets",
    edition = "2024",
)

rust_test(
    name = "unit_tests",
    crate = ":host_hil",
)
