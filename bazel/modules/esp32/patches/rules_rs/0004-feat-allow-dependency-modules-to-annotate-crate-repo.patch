diff --git a/rs/private/annotations.bzl b/rs/private/annotations.bzl
index 244f0bc..874fea5 100644
--- a/rs/private/annotations.bzl
+++ b/rs/private/annotations.bzl
@@ -97,18 +97,19 @@ def annotation_for(annotations_by_crate, crate_name, version, hub_name):
         return _windows_gnullvm_implicit_annotation(crate_name, version, hub_name)
     return _DEFAULT_CRATE_ANNOTATION
 
-def build_annotation_map(mod, cfg_name):
-    """Build mapping {crate: {version|\"*\": annotation}} for a cfg name."""
+def build_annotation_map(modules, cfg_name):
+    """Build an annotation map for a cfg from every module using the extension."""
     annotations = {}
-    for annotation in mod.tags.annotation:
-        if cfg_name not in (annotation.repositories or [cfg_name]):
-            continue
+    for mod in modules:
+        for annotation in mod.tags.annotation:
+            if cfg_name not in (annotation.repositories or [cfg_name]):
+                continue
 
-        version_key = annotation.version or "*"
-        crate_map = annotations.setdefault(annotation.crate, {})
-        if version_key in crate_map:
-            fail("Duplicate crate.annotation for %s version %s in repo %s" % (annotation.crate, version_key, cfg_name))
-        crate_map[version_key] = annotation
+            version_key = annotation.version or "*"
+            crate_map = annotations.setdefault(annotation.crate, {})
+            if version_key in crate_map:
+                fail("Duplicate crate.annotation for %s version %s in repo %s" % (annotation.crate, version_key, cfg_name))
+            crate_map[version_key] = annotation
     return annotations
 
 def well_known_annotation_snippet_paths(mctx):
diff --git a/rs/private/annotations_test.bzl b/rs/private/annotations_test.bzl
new file mode 100644
index 0000000..b86c0da
--- /dev/null
+++ b/rs/private/annotations_test.bzl
@@ -0,0 +1,54 @@
+load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
+load(":annotations.bzl", "build_annotation_map")
+
+def _annotation(crate, version, repositories = []):
+    return struct(
+        crate = crate,
+        repositories = repositories,
+        version = version,
+    )
+
+def _module(annotations):
+    return struct(tags = struct(annotation = annotations))
+
+def _annotations_from_multiple_modules_test_impl(ctx):
+    env = unittest.begin(ctx)
+    esp_config = _annotation("esp-config", "0.7.0", ["crates"])
+    esp_metadata = _annotation("esp-metadata-generated", "0.4.0", ["crates"])
+
+    annotations = build_annotation_map(
+        [
+            _module([esp_config]),
+            _module([esp_metadata]),
+        ],
+        "crates",
+    )
+
+    asserts.equals(env, esp_config, annotations["esp-config"]["0.7.0"])
+    asserts.equals(env, esp_metadata, annotations["esp-metadata-generated"]["0.4.0"])
+    return unittest.end(env)
+
+annotations_from_multiple_modules_test = unittest.make(_annotations_from_multiple_modules_test_impl)
+
+def _annotations_are_scoped_to_repository_test_impl(ctx):
+    env = unittest.begin(ctx)
+    default_repo = _annotation("default-repo", "")
+    named_repo = _annotation("named-repo", "1.0.0", ["other"])
+
+    annotations = build_annotation_map(
+        [_module([default_repo, named_repo])],
+        "crates",
+    )
+
+    asserts.equals(env, default_repo, annotations["default-repo"]["*"])
+    asserts.false(env, "named-repo" in annotations)
+    return unittest.end(env)
+
+annotations_are_scoped_to_repository_test = unittest.make(_annotations_are_scoped_to_repository_test_impl)
+
+def annotations_tests():
+    return unittest.suite(
+        "annotations_tests",
+        annotations_from_multiple_modules_test,
+        annotations_are_scoped_to_repository_test,
+    )
