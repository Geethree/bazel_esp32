diff --git a/rs/platforms/triples.bzl b/rs/platforms/triples.bzl
--- a/rs/platforms/triples.bzl
+++ b/rs/platforms/triples.bzl
@@ -6,6 +6,7 @@
 
 _RISCV_ISA_CONSTRAINTS = {
     "riscv32imac-unknown-none-elf": "@rules_rs//rs/platforms/constraints:rv32imac",
+    "riscv32imafc-unknown-none-elf": "@rules_rs//rs/platforms/constraints:rv32imafc",
     "riscv32imc-unknown-none-elf": "@rules_rs//rs/platforms/constraints:rv32imc",
 }
 
@@ -12,7 +13,10 @@
 def triple_to_rust_constraint_set(target_triple):
-    constraints = _triple_to_constraint_set(target_triple)
+    # rules_rust maps RV32IMAC but does not yet recognize the RV32IMAFC CPU.
+    # Both have the same generic RISC-V CPU constraint; select the ISA below.
+    mapped_triple = "riscv32imac-unknown-none-elf" if target_triple == "riscv32imafc-unknown-none-elf" else target_triple
+    constraints = _triple_to_constraint_set(mapped_triple)
     t = triple(target_triple)
 
@@ -144,7 +145,7 @@
     # "riscv32i-unknown-none-elf",       # * Bare RISC-V (RV32I ISA)
     # "riscv32im-unknown-none-elf",      # * Bare RISC-V (RV32IM ISA)
     "riscv32imac-unknown-none-elf",  # * Bare RISC-V (RV32IMAC ISA)
-    # "riscv32imafc-unknown-none-elf",   # * Bare RISC-V (RV32IMAFC ISA)
+    "riscv32imafc-unknown-none-elf",  # * Bare RISC-V (RV32IMAFC ISA)
     "riscv32imc-unknown-none-elf",  # * Bare RISC-V (RV32IMC ISA)
     "riscv64gc-unknown-linux-musl",  # ✓ RISC-V Linux (kernel 4.20+, musl 1.2.5)
     "riscv64gc-unknown-none-elf",  # * Bare RISC-V (RV64IMAFDC ISA)
diff --git a/rs/platforms/constraints/BUILD.bazel b/rs/platforms/constraints/BUILD.bazel
--- a/rs/platforms/constraints/BUILD.bazel
+++ b/rs/platforms/constraints/BUILD.bazel
@@ -36,6 +36,12 @@
 constraint_value(
     # ESP32-C6 and ESP32-H2 use the atomic-capable RV32IMAC target.
     name = "rv32imac",
+    constraint_setting = "riscv_isa",
+)
+
+constraint_value(
+    # ESP32-S31 uses the floating-point RV32IMAFC target.
+    name = "rv32imafc",
     constraint_setting = "riscv_isa",
 )
 
