# Added to the generated log 0.4.27 crate repository.
#
# Host build scripts resolve log with `std`, while ESP32-C6 target libraries
# require the same Cargo package without `std`. Keep the generated target for
# host tools and provide this target-only no_std variant.

rust_crate(
    name = "log-no-std",
    crate_name = "log",
    purl = "pkg:cargo/log@0.4.27",
    version = "0.4.27",
    aliases = {},
    deps = [],
    data = [],
    crate_features = [],
    triples = ["riscv32imac-unknown-none-elf"],
    conditional_crate_features = {},
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env = {"CARGO_MANIFEST_PATH": "$(execpath :Cargo.toml)"},
    rustc_flags = [],
    tags = [],
    target_compatible_with = RESOLVED_PLATFORMS,
    links = None,
    build_script = False,
    build_script_data = [],
    build_deps = [],
    build_script_env = {"CARGO_MANIFEST_PATH": "$(execpath :Cargo.toml)"},
    allow_build_script_to_detect_nonhermetic_paths = False,
    build_script_toolchains = [],
    build_script_tools = [],
    build_script_tags = [],
    is_proc_macro = False,
    has_lib = True,
    binaries = {},
    use_legacy_rules_rust_platforms = False,
)

alias(
    name = "log-contextual",
    actual = select({
        "@rules_rs//rs/platforms/config:riscv32imac-unknown-none-elf": ":log-no-std",
        "//conditions:default": ":log",
    }),
    visibility = ["//visibility:public"],
)
